# Copy to .env (never commit .env) and export before running the app.

# PostgreSQL
# Port 5433 matches docker-compose.yml (avoids clashing with a local PostgreSQL on 5432)
DB_URL=jdbc:postgresql://localhost:5433/travel_insurance
DB_USERNAME=travel
DB_PASSWORD=travel

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=travel
RABBITMQ_PASSWORD=travel

# JWT — must be at least 256 bits (32+ characters). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret-of-32-plus-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Field-level encryption (AES-256-GCM) for sensitive PII/medical columns
# (visitor identity/contact/medical fields, biometric subject IDs/tokens,
# claim/preauthorization medical free text). Generate each with:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Separate key used only for deterministic passport-number lookups
# (HMAC blind index) — never reuse the data key here.
APP_ENCRYPTION_BLIND_INDEX_KEY=
# Set to true for exactly ONE deploy to encrypt pre-existing plaintext data
# in an environment that had visitor/claim/biometric rows before
# field-level encryption was introduced, then set back to false.
# See EncryptionBackfillRunner and backend-architecture.md "Security".
APP_ENCRYPTION_BACKFILL_ENABLED=false

# eKYC biometric verification (ecitizen integration)
# Public URL eKYC will POST results to — must end in /api/v1/webhooks/biometric-verification
EKYC_CLIENT_ID=
EKYC_CLIENT_SECRET=
EKYC_NOTIFICATION_CALLBACK_URL=https://biometricsvbend.prismholdings.co.ke/api/v1/webhooks/biometric-verification
# Comma-separated eKYC egress IPs allowed to hit the webhook
EKYC_CALLBACK_ALLOWED_IPS=167.71.142.137,167.71.128.93

# SMTP — required for the policy document email sent when a visitor becomes ACTIVE.
# Any real provider works (SendGrid, AWS SES, Mailgun, Gmail w/ app password, etc.);
# STARTTLS is required (see application.yml).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# "From" address for outbound mail — ideally a verified sender on a domain with
# SPF/DKIM configured at the SMTP provider, or mail will likely land in spam.
MAIL_FROM=no-reply@example.com

# Emergency assistance contact shown on the emailed policy certificate
# (not modeled per-policy — every reference insurer hardcodes this too).
EMERGENCY_ASSISTANCE_PHONE=
EMERGENCY_ASSISTANCE_EMAIL=

# ExchangeRate-API — used to snapshot the KES->USD rate when invoices and
# claims are saved (see CurrencyConversionService). Base URL is public; the
# API key is a secret and must NOT be committed here — set it in your .env.
# Request shape: <base-url>/<api-key>/pair/KES/USD
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6
EXCHANGE_RATE_API_KEY=
