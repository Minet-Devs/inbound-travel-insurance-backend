# Copy to .env (never commit .env) and export before running the app.

# PostgreSQL
# Port 5433 matches docker-compose.yml (avoids clashing with a local PostgreSQL on 5432)
DB_URL=jdbc:postgresql://localhost:5433/travel_insurance
DB_USERNAME=travel
DB_PASSWORD=travel

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=travel
RABBITMQ_PASSWORD=travel

# JWT — must be at least 256 bits (32+ characters). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret-of-32-plus-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# eKYC biometric verification (ecitizen integration)
# Public URL eKYC will POST results to — must end in /api/v1/webhooks/biometric-verification
EKYC_CLIENT_ID=
EKYC_CLIENT_SECRET=
EKYC_NOTIFICATION_CALLBACK_URL=https://biometricsvbend.prismholdings.co.ke/api/v1/webhooks/biometric-verification
# Comma-separated eKYC egress IPs allowed to hit the webhook
EKYC_CALLBACK_ALLOWED_IPS=167.71.142.137,167.71.128.93
