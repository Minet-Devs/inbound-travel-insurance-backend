# Copy to .env (never commit .env) and export before running the app.

# PostgreSQL
# Port 5433 matches docker-compose.yml (avoids clashing with a local PostgreSQL on 5432)
DB_URL=jdbc:postgresql://localhost:5433/travel_insurance
DB_USERNAME=travel
DB_PASSWORD=travel

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=travel
RABBITMQ_PASSWORD=travel

# JWT — must be at least 256 bits (32+ characters). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret-of-32-plus-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
